# =============================================================================
# id_x_008 环境变量配置模板
# 复制为 .env 后修改实际值：
#   cp ops/.env.example ops/.env
#   vim ops/.env
# =============================================================================

# ===== 数据库 =====
POSTGRES_DB=id_x_008
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@sspostgres!

# ===== 加密 =====（可选；IAO_DB_ENCRYPTED=true 时 DB_PASSWORD 需经 encrypt_util 加密）
IAO_DB_ENCRYPTED=
IAO_SECRET_KEY=

# ===== 运行环境 =====
IAO_ENV=production          # production | staging | dev

# ===== 邮件 =====
IAO_MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD

# ======================================================================
# SSO / OAuth2 配置（CUHK ADFS 授权码授予流）
# 以下为 sme-iao.cuhk.edu.cn 应用组的注册信息，请按实际 ADFS 配置调整
# ======================================================================

# ADFS 端点（默认使用 CUHK 中央 ADFS，可按需覆盖）
IAO_OAUTH_ADFS_BASE=
IAO_OAUTH_ADFS_DISCOVERY_URL=
IAO_OAUTH_ADFS_JWKS_URL=

# OAuth2 凭据（从 ADFS 应用组获取，勿泄露至前端代码）
IAO_OAUTH_CLIENT_ID=d5b6ea03-977a-4885-b081-4d67e257455b
IAO_OAUTH_CLIENT_SECRET=8Un34AIKA3z3XrKvI7pAYU4QR5IfLZeAdQgHBnUr

# 回调地址（必须与 ADFS 应用组注册的 redirect_uri 完全一致）
IAO_OAUTH_REDIRECT_URI=https://sme-iao.cuhk.edu.cn/f/008/user/oauth2

# 业务站点根路径（供前端 SSO 跳转使用）
IAO_OAUTH_BUSINESS_URL=https://sme-iao.cuhk.edu.cn

# ===== 身份声明适配（可选；CUHK ADFS 默认已自动探测） =====
# IAO_OAUTH_UPN_CLAIM=upn            # UPN 声明名（默认按 upn→unique_name→winaccountname 探测）
# IAO_OAUTH_EMAIL_CLAIM=email         # 邮箱声明名（默认按 email→mail 探测）
# IAO_OAUTH_CLOCK_SKEW_SECONDS=300   # exp 校验时钟偏移容忍秒数
# IAO_OAUTH_NONCE=                   # 设为 1 启用 /token 请求 nonce 防重放

# ===== 前端 SSO 公开配置（构建期内联为 NEXT_PUBLIC_*，不含 client_secret） =====
# 用于 id_x_008_web 镜像构建（up.sh --build 会以 --build-arg 注入）
NEXT_PUBLIC_ADFS_CLIENT_ID=d5b6ea03-977a-4885-b081-4d67e257455b
NEXT_PUBLIC_ADFS_REDIRECT_URI=https://sme-iao.cuhk.edu.cn/f/008/user/oauth2
NEXT_PUBLIC_ADFS_RESOURCE=https://sme-iao.cuhk.edu.cn
