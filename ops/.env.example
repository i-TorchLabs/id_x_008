# id_x_008 环境变量模板
# 复制为 .env 后填入真实值，切勿将 .env 提交到版本控制

# PostgreSQL 数据库连接
POSTGRES_DB=id_x_008
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please

# 数据库凭据加密（若需 XOR+base64 加密存储凭据，设为 true）
IAO_DB_ENCRYPTED=false

# 加密密钥（IAO_DB_ENCRYPTED=true 时必填）
IAO_SECRET_KEY=

# 邮件通知（SMTP）
IAO_MAIL_SERVER=mail.cuhk.edu.cn
IAO_MAIL_PORT=587
IAO_MAIL_USER=careersme@cuhk.edu.cn
IAO_MAIL_FROM=careersme@cuhk.edu.cn
IAO_MAIL_PASSWORD=

# 运行环境（development / production）
IAO_ENV=development

# 可选：服务端口（默认 8101）
# IAO_PORT=8101
