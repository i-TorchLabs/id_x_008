# id_x_008 后端服务镜像（构建上下文为仓库根目录）
FROM python:3.10-slim AS builder

WORKDIR /app/i-Core

# 仅安装生产依赖（x_models/id_x_008/requirements.txt 作为依赖源）
# 注：所有依赖均有 manylinux x86_64 预编译 wheel，无需 build-essential/libpq-dev
COPY x_models/id_x_008/requirements.txt ./
RUN pip install --no-cache-dir --only-binary :all: -r requirements.txt

FROM python:3.10-slim
WORKDIR /app/i-Core

# useradd 为 Debian 基础组件（passwd 包 Priority: required），始终可用
RUN useradd -r -u 10001 -m appuser

COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY x_models/_contracts /app/i-Core/x_models/_contracts
COPY x_models/id_x_008 /app/i-Core/x_models/id_x_008

RUN mkdir -p /app/i-Core/logs && chown -R appuser:appuser /app/i-Core

ENV PROJECT_PATH=/app/i-Core \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    IAO_PORT=8101

USER appuser
EXPOSE 8101

HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=20s \
    CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8101/b/id_x_008/health')" || exit 1

CMD ["python", "x_models/id_x_008/x_plugin.py"]
